        "description": "6 ADRs documenting key decisions"
      },
      {
        "id": "superpowers",
        "name": "Superpowers Reference",
        "path": "kb/tool-reference/superpowers.md",
        "description": "Skill inventory, install, and upgrade policy for the superpowers dependency"
      }
    ]
  },
  "memory": {
    "path": "memory/",
    "description": "Long-term memory and learnings",
    "sections": [
      {
        "id": "feedback",
