{
  "id": "kirby-toolkit",
  "name": "Kirby Toolkit",
  "version": "2.1.0",
  "description": "AI SDLC toolkit: universal coding principles, a superpowers-backed multi-agent workflow, and an iterative loop for feel-driven design",
  "author": "Team",
  "license": "MIT",
  "dependencies": {
    "plugins": [
      {
        "id": "superpowers",
        "version": ">=6.0.0",
        "source": "https://github.com/obra/superpowers",
        "install": "/plugin install superpowers@claude-plugins-official",
        "required_by": [
          "at-build"
        ],
        "reason": "Provides the phase skills at-build orchestrates (TDD, planning, review, verification)"
      }
    ]
  },
  "skills": [
    {
      "id": "at-code",
      "name": "AT Code",
      "version": "1.2.0",
      "path": "skills/at-code/SKILL.md",
      "description": "Universal coding principles for all languages and frameworks",
      "tags": [
        "coding",
        "standards",
        "principles",
        "universal"
      ]
    },
    {
      "id": "at-build",
      "name": "AT Build",
      "version": "2.0.0",
      "path": "skills/at-build/SKILL.md",
      "description": "Superpowers-backed SDLC workflow: Align \u2192 Isolate \u2192 Plan \u2192 Implement \u2192 Review \u2192 Verify \u2192 Ship",
      "tags": [
        "workflow",
        "sdlc",
        "agents",
        "automation",
        "superpowers",
        "tdd"
      ],
      "requires": [
        "at-code",
        "superpowers"
      ]
    },
    {
      "id": "at-game-design",
      "name": "AT Game Design",
      "version": "1.3.0",
      "path": "skills/at-game-design/SKILL.md",
      "description": "Iterative loop for games and other feel-driven software: clarify, spec, build, play, measure, learn \u2014 with a self-review pass that proposes its own revisions",
      "tags": [
        "game-design",
        "iteration",
        "balance",
        "playtesting",
        "measurement",
        "self-improving"
      ],
      "requires": [
        "at-code"
      ]
    }
  ],
  "knowledge_base": {
    "path": "kb/",
    "description": "Persistent knowledge and standards",
    "sections": [
      {
